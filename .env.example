# gateway 与 cfbypass 共享的随机密钥，至少 16 位
GATEWAY_ADMIN_SECRET=请替换为随机高强度密钥

# 镜像入口访问密码，可设置为任意非空字符串；包含特殊字符时请按 Compose .env 语法加引号
GATEWAY_ACCESS_PASSWORD=请设置访问密码

# 生产环境保持 enable，并填写 Cloudflare Turnstile 生产密钥
CLOUDFLARE_TURNSTILE=enable
CLOUDFLARE_TURNSTILE_SITE_KEY=请填写生产站点密钥
CLOUDFLARE_TURNSTILE_SECRET_KEY=请填写生产密钥
TURNSTILE_SESSION_TTL_SECONDS=86400
COOKIE_SECURE=true

PORT=40005
CHATGPT_BASE_URL=https://chatgpt.com
CHATGPT_CDN_BASE_URL=https://cdn.oaistatic.com
CHATGPT_AB_BASE_URL=https://ab.chatgpt.com
REQUEST_TIMEOUT_SECS=180
RUST_LOG=info

# 可选：Gateway 出站代理，仅从环境变量读取，不写入数据库
MIRROR_DEFAULT_PROXY_URL=
MIRROR_PROXY_USERNAME=
MIRROR_PROXY_PASSWORD=

CF_BYPASS_HEADLESS=true
CF_BYPASS_MAX_WAIT_SECONDS=35
CF_BYPASS_PARTIAL_COOKIE_GRACE_SECONDS=8
CF_BYPASS_NAVIGATION_RETRIES=2
CF_BYPASS_ALLOWED_HOSTS=chatgpt.com,.chatgpt.com
